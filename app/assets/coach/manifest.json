   "f": "why_strength.m4a",
   "b": 19997,
   "ms": 3040,
   "text": "That sets your calories, how much you lift and how hard I push."
  },
  "why_cardio": {
   "f": "why_cardio.m4a",
   "b": 25478,
   "ms": 4000,
   "text": "That's how I know whether to plan runs, other cardio, or none."
  },
  "why_cardioRun": {
   "f": "why_cardioRun.m4a",
   "b": 21343,
   "ms": 3290,
   "text": "A race, or just fitness. That's how I plan your runs."
  },
  "why_race": {
   "f": "why_race.m4a",
   "b": 20476,
   "ms": 3150,
   "text": "The date tells me how to ramp the weeks and when to taper."
  },
  "why_runnow": {
   "f": "why_runnow.m4a",
   "b": 30766,
   "ms": 4850,
   "text": "A recent race is the best guide to your pace. Then how much you run each week, then your age and body."
